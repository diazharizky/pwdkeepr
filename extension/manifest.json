{
  "manifest_version": 3,
  "name": "pwdkeepr",
  "version": "0.1.0",
  "description": "Autofill and save logins from your local pwdkeepr vault.",
  "permissions": ["storage", "alarms", "activeTab"],
  "host_permissions": ["http://localhost:4848/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "pwdkeepr" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
